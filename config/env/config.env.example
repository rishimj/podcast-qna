# AWS Configuration - REQUIRED FOR REAL COST TRACKING
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Cost Monitoring Configuration
# The API refuses chat/summary requests (HTTP 429) once recorded Claude spend
# reaches a limit; the daily cost report flags the same limits. 0 disables one.
DAILY_BUDGET_LIMIT=5.00
WEEKLY_BUDGET_LIMIT=25.00
MONTHLY_BUDGET_LIMIT=100.00
COST_ALERT_EMAIL=your-email@gmail.com

# Public-site safeguards (backend/api/safeguards.py). Counts persist across
# restarts in data/databases/llm_usage.db. 0 disables a limit.
# Chat + summary requests per day, site-wide, and per client IP:
DAILY_REQUEST_LIMIT=300
IP_DAILY_REQUEST_LIMIT=40
# Any request, per client IP, per minute:
IP_BURST_LIMIT=30
# Emailing summaries to an address the visitor types in. Set to 0 on a public
# site so bots can't use your mail account to send to strangers (the app then
# hides the Email summary button):
EMAIL_ENABLED=1
# Summary emails per day, site-wide, and per client IP:
DAILY_EMAIL_LIMIT=20
IP_DAILY_EMAIL_LIMIT=3
# Request bodies above this many bytes are rejected (413):
MAX_BODY_BYTES=16384
# Chat sessions kept in memory (oldest are dropped first):
MAX_SESSIONS=500
# Optional shared password: when set, POST requests must send it in the
# X-Access-Code header (the web app asks for it once and remembers it).
ACCESS_CODE=
# Set to 1 only when running behind a reverse proxy or tunnel (Cloudflare
# Tunnel, ngrok, nginx) so per-IP limits use the real client address from
# X-Forwarded-For (the last entry, the one the proxy added) instead of the proxy's.
TRUST_PROXY=0
# Comma-separated browser origins allowed to call the API; * allows any.
ALLOWED_ORIGINS=*

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/podcast_qa
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/podcast_qa_test

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# Email Configuration (SMTP - Free!)
# For Gmail: Use App Password (not regular password)
# 1. Go to Google Account settings
# 2. Enable 2FA (required for app passwords)  
# 3. Generate App Password for "Mail"
# 4. Use that app password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com

# Other SMTP providers:
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# Custom: your-smtp-server.com:587

# Notion export (Save to Notion button). Create an internal integration at
# https://www.notion.so/my-integrations, copy its secret, then open the Notion
# page that should hold the exports and add the integration under
# "..." -> Connections. Paste that page's URL or id below.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Exports land in YOUR workspace, so on a public site either set ACCESS_CODE
# or turn this off (the app then hides the Save to Notion button):
NOTION_ENABLED=1

# Logging
LOG_LEVEL=INFO

# Cost Tracking Settings
ENABLE_COST_TRACKING=true
COST_CHECK_INTERVAL_MINUTES=60
EMERGENCY_STOP_BUDGET=50.00 